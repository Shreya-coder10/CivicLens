# ==============================================================================
# CivicLens - Environment Configuration (NeonDB + OpenRouter Open-Source Models)
# ==============================================================================

# Database Connection (PostgreSQL on NeonDB Serverless)
# Grab this from your Neon Console (https://console.neon.tech):
DATABASE_URL="postgresql://neondb_owner:npg_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth (Auth.js) Configuration
# Generate a secret using: `openssl rand -base64 32` or any random 32+ char string
NEXTAUTH_SECRET="civiclens-super-secure-production-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Open-Source GenAI via OpenRouter
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Recommended Open-Source Model:
# - meta-llama/llama-3.3-70b-instruct (State-of-the-art open weights, fast & accurate)
# - meta-llama/llama-3.1-8b-instruct:free (100% Free tier open source)
# - mistralai/mistral-7b-instruct:free (100% Free tier open source)
# - qwen/qwen-2.5-72b-instruct (Excellent open source reasoning)
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# Optional: Amazon S3 Bucket for Photographic Attachments
# If not provided, CivicLens automatically activates local preview mode for seamless evaluation!
S3_BUCKET_NAME=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
