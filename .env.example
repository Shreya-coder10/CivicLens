# ==============================================================================
# CivicLens - Environment Variables (NeonDB & OpenRouter Open-Source AI)
# ==============================================================================

# 1. Database Connection (NeonDB Serverless PostgreSQL)
# Create a free project at https://console.neon.tech and paste your connection string:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. NextAuth (Auth.js) Session Secret
NEXTAUTH_SECRET="civiclens-super-secure-production-secret-9876543210"
NEXTAUTH_URL="http://localhost:3000"

# 3. Open-Source AI via OpenRouter (No expensive proprietary models needed)
# Generate a free or pay-as-you-go key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Recommended Open-Source Models:
# - meta-llama/llama-3.3-70b-instruct (Fast, top-tier open weights model)
# - meta-llama/llama-3.1-8b-instruct:free (100% Free tier open model)
# - mistralai/mistral-7b-instruct:free (100% Free tier open model)
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# Optional: Amazon S3 (If omitted, local image preview is automatically used)
S3_BUCKET_NAME=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
